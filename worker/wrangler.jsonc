{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kamureii-xdr-edge",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-25",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1
    }
  },
  "vars": {
    "GITHUB_USERNAME": "kamureii",
    "LINKEDIN_URL": "https://www.linkedin.com/in/kamureii/",
    "SENSOR_NAME": "kamureii-xdr-edge.sys",
    "BURST_THRESHOLD": "5"
  },
  "d1_databases": [
    {
      "binding": "TELEMETRY_DB",
      "database_name": "kamureii-xdr-telemetry",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ]
}
